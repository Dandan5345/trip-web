# Optional overrides. The client ships with the public TripEase project
# configuration baked in, so it builds and runs without this file.
#
# Copy to `.env.local` (untracked) to point the client somewhere else.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA v3 site key (public). Required in production.
# VITE_APPCHECK_SITE_KEY=

# Local-only App Check debug token. Never commit a real one.
# VITE_APPCHECK_DEBUG_TOKEN=
